# Required for local development
VITE_SUPABASE_URL=your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_CLIENT_ID=your-google-client-id
# Public Google Picker browser key. Restrict it in Google Cloud by HTTP referrer and API scope.
VITE_GOOGLE_API_KEY=your-restricted-google-picker-api-key

# Required for server-side (Vercel)
SUPABASE_URL=your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_AI_KEY=your-server-side-google-ai-key
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
CRON_SECRET=your-cron-secret
APP_ORIGIN=http://localhost:5173

# Required for Paddle billing
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
PADDLE_PRO_PRICE_ID=your-pro-price-id
PADDLE_FAMILY_PRICE_ID=your-family-price-id
PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_CLIENT_TOKEN=your-paddle-client-token
VITE_PADDLE_ENVIRONMENT=sandbox

# Optional
ENCRYPTION_SECRET=your-encryption-secret
GEMINI_API_KEY=your-server-side-gemini-api-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_KINDI_AI_ENABLED=false

# Development
NODE_ENV=development
