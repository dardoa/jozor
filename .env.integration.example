# Integration Test Environment Variables (staging by default)
# Metadata preflight works with false. Real integration mutations still require true.
ALLOW_INTEGRATION_MUTATIONS=false
SUPABASE_INTEGRATION_TARGET=staging
SUPABASE_INTEGRATION_PROJECT_REF=<staging-project-ref>
SUPABASE_PRODUCTION_PROJECT_REF=<production-project-ref>
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
ENCRYPTION_SECRET=

# Owner-authorized prelaunch exception, only for the reviewed media suite:
# Use a separate ignored .env.integration.prelaunch, never silently relabel staging.
# SUPABASE_INTEGRATION_TARGET=prelaunch
# SUPABASE_PRELAUNCH_APPROVED_PROJECT_REF=<exact-CLI-linked-project-ref>
# SUPABASE_PRELAUNCH_ACKNOWLEDGEMENT=owner-approved-test-data
# SUPABASE_INTEGRATION_PROJECT_REF and URL must match the app and linked project.
# Keep ALLOW_INTEGRATION_MUTATIONS=false until the backup and migration gates pass.
# General integration and local fault-injection suites remain denied on prelaunch.
