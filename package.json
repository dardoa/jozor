{
  "name": "jozor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "format": "prettier --write .",
    "test": "npm run test:unit:shard:1 && npm run test:unit:shard:2",
    "test:unit:shard:1": "vitest run --shard=1/2",
    "test:unit:shard:2": "vitest run --shard=2/2",
    "test:integration:supabase": "vitest run --config vitest.integration.config.ts",
    "test:database:local": "vitest run --config vitest.database.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/app-smoke.spec.ts --project=chromium --reporter=line",
    "test:e2e:collab:live": "playwright test tests/e2e/collaboration-live.spec.ts --project=chromium --reporter=line",
    "test:layout:perf": "vitest run src/domain/__tests__/familyGraphPerformance.test.ts",
    "test:render:guard": "vitest run src/components/charts/__tests__/V3FamilyGraphRenderer.test.tsx src/components/tree/node/__tests__/NodeContainer.test.tsx",
    "test:render:runtime": "playwright test tests/e2e/render-runtime.spec.ts --project=chromium --reporter=line",
    "test:shared-tree:unit": "vitest run services/__tests__/proxyService.test.ts components/__tests__/SharedTreeLoader.test.tsx services/__tests__/supabaseTreeService.test.ts components/__tests__/Header.test.tsx components/__tests__/TreeSelector.test.tsx store/__tests__/useAppStore.test.ts",
    "test:shared-tree:smoke": "playwright test tests/e2e/app-smoke.spec.ts --project=chromium --reporter=line --grep \"persisted debug scenario restores the tree name in the header|sync diagnostics surface pending work and retryable errors|shared tree access changes from owner to viewer to editor and editor changes persist after reload\"",
    "test:telemetry": "npm run test:telemetry:unit && npm run test:telemetry:smoke",
    "test:telemetry:unit": "vitest run services/__tests__/treeInvitationService.test.ts components/__tests__/DiagnosticsDrawer.test.tsx components/__tests__/ActivityLogDrawer.test.tsx",
    "test:telemetry:smoke": "playwright test tests/e2e/app-smoke.spec.ts --project=chromium --reporter=line --grep \"invitation diagnostics surface realtime and owner correlation details|invitation diagnostics surface telemetry errors\""
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.17",
    "@google/generative-ai": "^0.24.1",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@sparticuz/chromium": "^149.0.0",
    "@supabase/supabase-js": "^2.87.1",
    "browser-image-compression": "^2.0.2",
    "crypto-js": "^4.2.0",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "dompurify": "^3.3.0",
    "fuse.js": "^7.1.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "puppeteer-core": "^25.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^2.9.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "sonner": "^1.7.0",
    "supercluster": "^8.0.1",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/crypto-js": "^4.2.2",
    "@types/d3": "^7.4.3",
    "@types/d3-dispatch": "^3.0.7",
    "@types/gapi": "^0.0.47",
    "@types/gapi.client.drive": "^3.0.15",
    "@types/google.accounts": "^0.0.18",
    "@types/google.picker": "^0.0.52",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vercel/node": "^2.3.0",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.49.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=5.29.0",
      "esbuild": ">=0.25.0",
      "google-auth-library>jws": ">=4.0.1"
    }
  }
}
