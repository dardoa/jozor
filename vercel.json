{
  "version": 2,
  "crons": [
    {
      "path": "/api/person-media-cleanup-cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/push-reminder-cron",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
